<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Suyash Gamer 10 Ultra Hub</title>
    <!-- Google Search Console Verification Meta Tag -->
    <meta name="google-site-verification" content="tyA3K6nxxpddmc1wOCd4WqLtxiNZQH0dGZC_DU1d3BA">
    <style>
        :root {
            --bg-color: #0d1117;
            --card-bg: #161b22;
            --accent-color: #00ffcc;
            --text-color: #ffffff;
            --text-secondary: #8b949e;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }
        header {
            text-align: center;
            margin-bottom: 30px;
        }
        h1 {
            font-size: 2.2rem;
            color: var(--accent-color);
            text-shadow: 0 0 10px rgba(0, 255, 204, 0.5);
            margin-bottom: 5px;
        }
        p.subtitle {
            color: var(--text-secondary);
            font-size: 1rem;
        }
        .container {
            width: 100%;
            max-width: 800px;
            display: grid;
            gap: 20px;
        }
        .card {
            background-color: var(--card-bg);
            border: 1px solid #30363d;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            transition: transform 0.2s, border-color 0.2s;
        }
        .card:hover {
            border-color: var(--accent-color);
            transform: translateY(-2px);
        }
        .card h2 {
            font-size: 1.4rem;
            margin-bottom: 12px;
            color: var(--accent-color);
        }
        .btn-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 12px;
            margin-top: 15px;
        }
        a.btn {
            display: inline-block;
            text-align: center;
            background: linear-gradient(135deg, #00ffcc, #0077ff);
            color: #000;
            font-weight: bold;
            padding: 12px 16px;
            border-radius: 8px;
            text-decoration: none;
            transition: opacity 0.2s, box-shadow 0.2s;
        }
        a.btn:hover {
            opacity: 0.9;
            box-shadow: 0 0 12px rgba(0, 255, 204, 0.6);
        }
        footer {
            margin-top: 40px;
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <header>
        <h1>Suyash Gamer 10 Ultra Hub</h1>
        <p class="subtitle">Official Gaming Portal & Master Dashboard</p>
    </header>

    <div class="container">
        <!-- Gaming & Videos Section -->
        <div class="card">
            <h2>🎮 YouTube & Gaming Content</h2>
            <p>Explore gameplay videos, shorts, and live action updates from Suyash Gamer 10.</p>
            <div class="btn-grid">
                <a href="https://youtube.com/@suyashgamer3101" target="_blank" class="btn">YouTube Channel</a>
                <a href="https://instagram.com/suyash_gamer_10" target="_blank" class="btn">Instagram</a>
            </div>
        </div>

        <!-- 3D Game Project Section -->
        <div class="card">
            <h2>⚡ Shadow Protocol: Cyber City</h2>
            <p>Experience open-world 3D action gameplay and development builds.</p>
            <div class="btn-grid">
                <a href="#" class="btn">Launch Game</a>
            </div>
        </div>
    </div>

    <footer>
        <p>&copy; 2026 Suyash Sachin Shete | All Rights Reserved.</p>
    </footer>

</body>
</html>
